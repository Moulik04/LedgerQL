# Internal planning docs — not part of the public project
LEDGERQL_MASTER_PROMPT.md
PHASE_5_5_MASTER_PROMPT.md
PHASE_5_5_AMENDMENT_1.md

# Local git worktrees
.worktrees/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# uv
uv.lock.bak

# Env
.env

# Data (large, regenerable — never commit)
data/*.duckdb
data/raw/
data/*.zip

# Logs (runtime audit trail)
logs/

# Model weights / caches
*.gguf
*.safetensors
.ollama/

# Reports (generated by make eval, not source)
reports/*.md
!reports/baseline.md
!reports/eval.md
!reports/phase5_model_comparison.md
reports/*.jsonl
!reports/.gitkeep
# Bridges-2 runs are the *evidence* behind every headline figure and every
# derived (replayed) one: tests and evals/replay_derived.py read them. Ignoring
# them meant a fresh clone silently skipped the "reproduces the report exactly"
# tests and the derived figures could not be regenerated by anyone.
!reports/eval_bridges2_*.md
!reports/eval_bridges2_*.jsonl
# Cluster runs write here (job-specific); they must never touch a tracked file.
reports/runs/

# Testing / tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.DS_Store
.vscode/
.idea/

# Bridges-2 / SLURM
scripts/bridges2/*.out
scripts/bridges2/*.err
