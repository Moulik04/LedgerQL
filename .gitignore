LEDGERQL_MASTER_PROMPT.md
PHASE_5_5_MASTER_PROMPT.md
PHASE_5_5_AMENDMENT_1.md
PHASE_5_5_AMENDMENT_2.md

# Local git worktrees
.worktrees/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# uv
uv.lock.bak

# Env
.env

# Data (large, regenerable — never commit)
data/*.duckdb
data/raw/
data/*.zip

# Logs (runtime audit trail)
logs/

# Model weights / caches
*.gguf
*.safetensors
.ollama/

# Reports (generated by make eval, not source)
reports/*.md
!reports/baseline.md
!reports/eval.md
!reports/phase5_model_comparison.md
reports/*.jsonl
!reports/.gitkeep
# Bridges-2 runs are the *evidence* behind every headline figure and every
# derived (replayed) one: tests and evals/replay_derived.py read them. Ignoring
# them meant a fresh clone silently skipped the "reproduces the report exactly"
# tests and the derived figures could not be regenerated by anyone.
!reports/eval_bridges2_*.md
!reports/eval_bridges2_*.jsonl
# Cluster runs write here (job-specific); they must never touch a tracked file.
reports/runs/
# ...but the bake-off's compact evidence (candidate SQL only, no raw replies) is tracked:
# every bake-off figure is re-scored from it (evals/bakeoff_evidence.py).
!reports/bakeoff_candidates.jsonl
!reports/gold_v2_rescore.md
!reports/pool_experiment.md
!reports/entity_upper_bound.md
!reports/entity_link_7b.md
!reports/entity_link_7b_candidates.jsonl

# Testing / tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.DS_Store
.vscode/
.idea/

# Bridges-2 / SLURM
scripts/bridges2/*.out
scripts/bridges2/*.err
