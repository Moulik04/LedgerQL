# Copy to .env and adjust. Nothing here should ever require a paid tier.

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TEMPERATURE=0.2
OLLAMA_SEED=42

# DuckDB
LEDGERQL_DB_PATH=data/ledgerql.duckdb

# Pipeline
LEDGERQL_NUM_SAMPLES=5
LEDGERQL_CONFIDENCE_THRESHOLD=0.7
LEDGERQL_QUERY_TIMEOUT_SECONDS=10
LEDGERQL_ROW_LIMIT=1000

# Bridges-2 (Phase 5+, optional — leave blank on the Mac)
BRIDGES2_USER=
BRIDGES2_ALLOCATION=
